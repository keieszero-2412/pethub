{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/shop", "destination": "/src/pages/shop.html" },
    { "source": "/booking", "destination": "/src/pages/booking.html" },
    { "source": "/health", "destination": "/src/pages/health.html" },
    { "source": "/rescue", "destination": "/src/pages/rescue.html" },
    { "source": "/dashboard", "destination": "/src/pages/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}